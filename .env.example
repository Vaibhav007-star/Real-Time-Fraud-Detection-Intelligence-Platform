# Real-Time Fraud Detection Intelligence Platform - Environment Configuration
# Copy this file to .env and adjust values as needed. Never commit real credentials.

APP_NAME="Real-Time Fraud Detection Intelligence Platform"
APP_ENV="development"
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000"

# Database Configuration
# For local development without PostgreSQL, SQLite is used automatically.
# For PostgreSQL deployment: postgresql://fraud_user:change_me_in_local_env@localhost:5432/fraud_platform
DATABASE_URL="sqlite:///./fraud_platform.db"

# Streaming & Kafka Configuration
# Set STREAMING_MODE="in_process" for local demo mode, or "kafka" when a Kafka cluster is available.
STREAMING_MODE="in_process"
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TRANSACTION_TOPIC="financial.transactions.v1"
KAFKA_ALERT_TOPIC="fraud.alerts.v1"
KAFKA_DLQ_TOPIC="financial.transactions.dlq.v1"
KAFKA_CONSUMER_GROUP="fraud-intelligence-engine"

# Hybrid Risk Scoring Weights (must sum to 1.0)
WEIGHT_ML_SCORE=0.45
WEIGHT_GRAPH_SCORE=0.30
WEIGHT_RULE_SCORE=0.25

# Operational Risk Thresholds (0.0 to 1.0)
THRESHOLD_REVIEW=0.45
THRESHOLD_HIGH_RISK=0.72

# Alerting & Suppression
ALERT_COOLDOWN_SECONDS=120
MAX_LATE_EVENT_SECONDS=86400

# Graph & Rolling State Bounds
GRAPH_MAX_NODES=10000
GRAPH_LOOKBACK_SECONDS=86400
GRAPH_MAX_TRAVERSAL_DEPTH=3
FEATURE_WINDOW_MAX_EVENTS=5000

# Upload & Security Limits
MAX_UPLOAD_BYTES=10485760
API_ADMIN_TOKEN="demo-analyst-token-change-in-prod"
